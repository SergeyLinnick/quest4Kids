{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["NEXT_PUBLIC_API_URL", "REACT_APP_API_URL", "API_URL", "SESSION_SECRET", "SESSION_DURATION"],
			"inputs": ["$TURBO_DEFAULT$", ".env*", ".env.local"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"clean": {
			"outputs": [".next/**", "dist/**", "build/**", "node_modules/**"]
		}
	},

	"globalEnv": [
		"NEXT_PUBLIC_API_URL",
		"REACT_APP_API_URL",
		"API_URL",
		"OPENAI_API_KEY",
		"ZITADEL_POST_LOGOUT_URL",
		"ZITADEL_DOMAIN",
		"ZITADEL_CLIENT_ID",
		"ZITADEL_CLIENT_SECRET",
		"SESSION_SECRET",
		"SESSION_DURATION"
	],
	"globalDependencies": [".env"]
}
